# Server-only configuration
# Never expose these values to the browser via NEXT_PUBLIC_ variables.
GROQ_API_KEY=your_groq_api_key_here
ALLOW_USER_GROQ_KEY=false

# Optional runtime configuration
# NODE_ENV=production
# NEXT_PUBLIC_APP_NAME=vibe-coded-cleanup

# Security notes:
# - GROQ_API_KEY is server-only and must never be exposed to browser code.
# - ALLOW_USER_GROQ_KEY is opt-in and should only be enabled if you explicitly want
#   to accept a user-supplied Groq key from the browser.
# - Prefer server-managed credentials in production.
